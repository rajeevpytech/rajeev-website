# Insert these locations into the EXISTING HTTPS server for rajeevfreelancer.com.
# Set root and the proxy port to your CURRENT project path/API port.
# Keep your existing certificate configuration. Do not create a second conflicting location /.
root /var/www/rajeevfreelancer/frontend/build;

location ^~ /static/ {
    try_files $uri =404;
    expires 1y;
    add_header Cache-Control "public, immutable";
}

# Public HTML, live sitemap/robots/feed and JSON API all reach FastAPI.
# Its route resolver serves the exact built file or live content and returns true 404s.
# A blanket /index.html SPA fallback would undo the SEO delivery fixes.
location / {
    proxy_pass http://127.0.0.1:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 90s;
}
